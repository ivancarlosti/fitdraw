# Fitdraw — copy to .env and adjust.
#
#   cp .env.example .env
#   docker compose up -d

# Port published on the host (container always listens on 80).
FITDRAW_PORT=3030

# Origin users open in a browser. MCP export links and the MCP UI are built from
# it, so it must be reachable exactly as written (scheme + host + optional port,
# no trailing slash and no path).
#
#   local:      http://localhost:3030
#   production: https://fitdraw.example.com
FITDRAW_PUBLIC_URL=http://localhost:3030

# Encrypted scenes kept on disk, in days (0 = never delete).
SCENE_TTL_DAYS=30

# Optional. When set, every POST /mcp requires
#   Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Set to 0 to disable a service inside the container.
ENABLE_ROOM=1
ENABLE_MCP=1
